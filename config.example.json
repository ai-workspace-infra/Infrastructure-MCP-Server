{
  "server": {
    "name": "infrastructure-mcp-server",
    "version": "0.1.0"
  },
  "backends": [
    {
      "name": "observability-grafana",
      "capability": "observability",
      "transport": "streamable-http",
      "url": "https://mcp.svc.plus/v1/grafana/mcp",
      "enabled": false,
      "timeout_seconds": 30,
      "bearer_token_env": "MCP_SERVICE_TOKEN"
    },
    {
      "name": "observability-metrics",
      "capability": "observability",
      "transport": "streamable-http",
      "url": "https://mcp.svc.plus/v1/metrics/mcp",
      "enabled": true,
      "timeout_seconds": 30,
      "bearer_token_env": "MCP_SERVICE_TOKEN"
    },
    {
      "name": "observability-logs",
      "capability": "observability",
      "transport": "streamable-http",
      "url": "https://mcp.svc.plus/v1/logs/mcp",
      "enabled": true,
      "timeout_seconds": 30,
      "bearer_token_env": "MCP_SERVICE_TOKEN"
    },
    {
      "name": "observability-traces",
      "capability": "observability",
      "transport": "streamable-http",
      "url": "https://mcp.svc.plus/v1/traces/mcp",
      "enabled": true,
      "timeout_seconds": 30,
      "bearer_token_env": "MCP_SERVICE_TOKEN"
    },
    {
      "name": "ssh",
      "capability": "runtime",
      "command": "npx",
      "args": [
        "-y",
        "@fangjunjie/ssh-mcp-server",
        "--config-file",
        "/run/ssh-mcp/ssh-config.json",
        "--pty",
        "false"
      ],
      "timeout_seconds": 30,
      "allowed_tools": [
        "list-servers",
        "execute-command"
      ],
      "disabled_tools": [
        "write-file",
        "upload",
        "download",
        "read-file",
        "job-*"
      ],
      "enabled": false
    },
    {
      "name": "kubernetes",
      "capability": "runtime",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-kubernetes"
      ],
      "enabled": false
    },
    {
      "name": "helm",
      "capability": "runtime",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-helm"
      ],
      "enabled": false
    },
    {
      "name": "netbox",
      "capability": "cmdb",
      "command": "uvx",
      "args": [
        "netbox-mcp"
      ],
      "enabled": false
    },
    {
      "name": "terraform",
      "capability": "iac",
      "command": "terraform-mcp",
      "args": [],
      "enabled": false
    },
    {
      "name": "opentofu",
      "capability": "iac",
      "command": "opentofu-mcp",
      "args": [],
      "enabled": false
    },
    {
      "name": "vault",
      "capability": "security",
      "command": "uvx",
      "args": [
        "vault-mcp"
      ],
      "enabled": false
    },
    {
      "name": "ansible",
      "capability": "iac",
      "command": "ansible-playbook-mcp",
      "args": [],
      "enabled": false
    },
    {
      "name": "github",
      "capability": "scm",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": false
    },
    {
      "name": "cloudflare",
      "capability": "dns",
      "command": "npx",
      "args": [
        "-y",
        "@cloudflare/mcp-server-cloudflare"
      ],
      "enabled": false
    }
  ]
}
